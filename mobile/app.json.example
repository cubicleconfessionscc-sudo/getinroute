{
  "expo": {
    "name": "GetInRoute",
    "slug": "clement",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/25f0833c-90f8-426f-bacb-0e2e12527a3e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#10141A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getinroute.employee",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GetInRoute needs your location to track your commute and, for drivers, to share live position with employees and admins.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GetInRoute needs background location during an active trip so live tracking keeps working while the app is minimized."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.getinroute.employee",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10141A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZ6JqrpMh1o8_zbtR_N1RNjaPDJQKSEgE"
        }
      },
      "versionCode": 18
    },
    "extra": {
      "eas": {
        "projectId": "25f0833c-90f8-426f-bacb-0e2e12527a3e"
      }
    },
    "owner": "clementedwins-team"
  }
}
