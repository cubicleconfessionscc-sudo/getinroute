{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-testflight": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "school": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "school"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production"
    }
  }
}