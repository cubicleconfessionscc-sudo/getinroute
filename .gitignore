# ---- GetInRoute root ignore ----
# Secrets - never commit
.env
*.env
.env.*
!*.env.example

# Signing keys and build credentials - never commit
secrets/
*.jks
*.keystore
mobile/android/
mobile/.expo/
.gradle/
apk-backups/
artifacts/

# Databases and business data
*.db
*.db-wal
*.db-shm
*.bak
data/
backups/
uploads/
migration-backups/

# Logs
logs/
*.log

# Node
node_modules/

# Deploy artifacts (generated update bundles)
deploy/*.zip
deliverables/
# Keep the three gate APKs packable by `railway up`: a directory-level
# backend/binaries/ rule would defeat the ! negations below (CLI packers use
# gitignore semantics, and files inside an excluded directory cannot be
# re-included). The other binaries stay out of the archive.
# Ignore only extra raw build artifacts. The published APKs must remain
# packable by `railway up` — its packer does not reliably apply trailing
# `!` negation patterns, which silently left newer APKs out of the image.
backend/binaries/*.aab
backend/binaries/GetInRoute-Driver.apk
backend/binaries/GetInRoute-Employee.apk
.railway/

# Build output lives only under backend/public/admin (served); don't track dev duplicates or source maps
frontend/dist/
backend/public/admin/assets/*.map

# OS
Thumbs.db
Desktop.ini
# Scratch/temp output kept inside the repo root
Temp/
