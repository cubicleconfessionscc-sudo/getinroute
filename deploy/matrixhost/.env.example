# GetInRoute Backend - Production Environment Variables
# Copy this file to .env on the production server and fill in the values.

# ---- Server ----
PORT=3000
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata

# ---- Database (SQLite by default; the data volume is mounted at /data) ----
DB_PATH=/data/getinroute.db
BACKUP_KEEP=14
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# ---- Auth ----
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-MIN-64-CHARS
ALLOWED_ORIGINS=https://www.getinroute.in,https://getinroute.in,http://localhost:5173

# ---- Email / SMS (placeholders - leave blank to use log-to-console mode) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- Optional features ----
APK_SEED_VERSION=v2026.10.14.1
