# GetInRoute frontend build-time environment
# Copy to .env.local (or set in your host's build env) before building.

# MapTiler API key (https://cloud.maptiler.com -> Account -> API keys)
# When set, all Leaflet maps use MapTiler tiles; otherwise OpenStreetMap is used.
VITE_MAPTILER_KEY=

# Google Maps JavaScript API key (GCP -> "Maps JavaScript API" + "Places API")
# Enables the Google map view on the Routes page; falls back to Leaflet when empty.
VITE_GOOGLE_MAPS_API_KEY=