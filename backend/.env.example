# ============================================================
# GetInRoute local configuration — copy to .env and fill in.
# NEVER commit real secrets. This file only documents the keys.
# ============================================================

# --- Server ---
PORT=4000
# Bind address. Default 127.0.0.1 (loopback). Set HOST=0.0.0.0 ONLY on the
# Railway/cloud deployment so the platform's proxy can reach the app.
HOST=127.0.0.1
# Production runs with this (no effect on code that does not read it, kept for
# conventions/scripts). SIMULATE_GPS=0 is mandatory for production.
NODE_ENV=production

# --- PostgreSQL (production path) ---
# WHEN SET, the backend runs against PostgreSQL instead of SQLite (see
# pg-schema.js / pgdb.js / pg-migrate.js). Leave empty for local SQLite dev.
# Railway provides this as <internal-railway-url> -> postgresql://user:pass@host:5432/railway
DATABASE_URL=
# Application timezone for stored timestamps (text, SQLite-compatible format).
# Default Asia/Kolkata. Railway servers run UTC, so this MUST be set for
# correct "today" boundaries. Keep identical between app and pg-migrate runs.
APP_TIMEZONE=Asia/Kolkata

# Frontend origin used for CORS + reset-password links. In production this
# MUST be the public HTTPS origin, e.g. https://www.getinroute.in
FRONTEND_URL=https://www.getinroute.in
# Extra CORS origins, comma-separated (public HTTPS origin + dev origin).
ALLOWED_ORIGINS=https://www.getinroute.in,https://getinroute.in,http://localhost:5173

# JWT signing secret. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# --- Local layout (D: drive required) ---
DB_PATH=D:\GetInRoute\data\getinroute.db
UPLOAD_DIR=D:\GetInRoute\uploads
# Startup auto-snapshots kept under data\backups (days).
BACKUP_KEEP=14

# --- Tiered backups (D:\GetInRoute\backups\{daily,weekly,monthly}) ---
BACKUP_DIR=D:\GetInRoute\backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Optional off-site copy target (e.g. a second drive/network folder). Leave
# empty to skip. Never put cloud-share credentials in this file.
OFF_SITE_DIR=

# --- GPS / realtime ---
# SIMULATE_GPS=1 enables the demo "cars drive themselves" simulator (writes
# demo movement to the DB). Leave 0/empty for real GPS only.
SIMULATE_GPS=0
# Server-side coalescing for the movement-history trail (ms per subject).
GPS_HISTORY_COALESCE_MS=15000
# How many days of movement history to keep before pruning.
LOCATION_HISTORY_RETAIN_DAYS=90

# --- SMS: leave all three empty to run in simulated mode (logs + sms_log) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email: leave empty to log mail to the console only ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@getinroute.app

# --- Owner identification (emp_id of the platform owner) ---
OWNER_EMAIL=admin@getinroute.com
OWNER_EMP_ID=ADMIN

# --- Optional AI assistant (Eddie) ---
OPENROUTER_API_KEY=
EDDIE_MODEL=openrouter/free